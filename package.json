{
  "name": "datagallery",
  "version": "0.2.0",
  "description": "Open-source enterprise Data Agent workbench for trustworthy, auditable data analysis.",
  "license": "Apache-2.0",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/datagallery-lab/datafoundry.git"
  },
  "homepage": "https://github.com/datagallery-lab/datafoundry#readme",
  "bugs": {
    "url": "https://github.com/datagallery-lab/datafoundry/issues"
  },
  "keywords": [
    "data-agent",
    "data-analysis",
    "semantic-layer",
    "nl2sql",
    "agent-workbench",
    "enterprise-ai",
    "mcp",
    "ag-ui",
    "mastra",
    "copilotkit"
  ],
  "publishConfig": {
    "access": "public"
  },
  "files": [
    ".env.example",
    "CONTRIBUTING.md",
    "LICENSE",
    "README.md",
    "README_zh.md",
    "apps",
    "docs",
    "mkdocs.yml",
    "requirements-docs.txt",
    "requirements.txt",
    "scripts",
    "tsconfig.base.json"
  ],
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "apps/web",
    "apps/tui"
  ],
  "scripts": {
    "postinstall": "node scripts/postinstall.mjs",
    "build": "npm run build:web && npm run build:tui",
    "build:web": "npm --workspace @datagallery/web run build",
    "build:tui": "npm --workspace @datagallery/tui run build",
    "start:api": "node scripts/start.mjs --api",
    "start:web": "node scripts/start.mjs --web",
    "start": "node scripts/start.mjs",
    "test:deploy": "node --test scripts/deploy/*.test.mjs scripts/stack-runtime-config.test.mjs scripts/password-only-cutover.test.mjs",
    "smoke:native-deploy": "node scripts/deploy/smoke-native-deploy.mjs",
    "test:web": "npm --workspace @datagallery/web run test",
    "test:tui": "npm --workspace @datagallery/tui run test",
    "test:product": "uv run --project runtime/agentkit python scripts/run_product_tests.py",
    "start:tui": "node -- apps/tui/dist/index.js",
    "docs:dev": "python -m mkdocs serve -a 127.0.0.1:8000",
    "docs:build": "python -m mkdocs build --strict",
    "smoke:docs": "node scripts/smoke-doc-links.mjs"
  },
  "devDependencies": {
    "@types/busboy": "^1.5.4",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.20.0",
    "@types/yauzl": "^3.4.0",
    "typescript": "^5.8.0",
    "vitest": "^3.2.6",
    "write-excel-file": "^4.1.1"
  },
  "dependencies": {
    "@ag-ui/client": "^0.0.57",
    "@ag-ui/core": "^0.0.57",
    "@ag-ui/mastra": "^1.0.3",
    "@ag-ui/mcp-middleware": "^0.0.1",
    "@ai-sdk/openai": "^3.0.73",
    "@copilotkit/runtime": "^0.0.0-mme-ag-ui-0-0-46-20260227141603",
    "@huggingface/tokenizers": "^0.1.3",
    "@mastra/client-js": "^1.25.0",
    "@mastra/core": "^1.46.0",
    "@types/nodemailer": "^8.0.1",
    "argon2": "^0.44.0",
    "nodemailer": "^9.0.3",
    "read-excel-file": "^9.2.0",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "rxjs": "7.8.1",
    "zod": "^4.4.3"
  },
  "overrides": {
    "@ag-ui/client": "^0.0.57",
    "@ag-ui/core": "^0.0.57",
    "@ag-ui/langgraph": "0.0.42"
  }
}
