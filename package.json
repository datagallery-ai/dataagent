{
  "name": "dataagent-workspace",
  "version": "0.2.0",
  "description": "Development workspace for DataAgent and its optional UI",
  "license": "Apache-2.0",
  "private": true,
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/datagallery-lab/datafoundry.git"
  },
  "homepage": "https://github.com/datagallery-lab/datafoundry#readme",
  "bugs": {
    "url": "https://github.com/datagallery-lab/datafoundry/issues"
  },
  "keywords": [
    "data-agent",
    "data-analysis",
    "semantic-layer",
    "nl2sql",
    "agent-workbench",
    "enterprise-ai",
    "mcp",
    "ag-ui",
    "mastra",
    "copilotkit"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "workspaces": [
    "ui/web",
    "ui/tui"
  ],
  "scripts": {
    "postinstall": "node scripts/postinstall.mjs",
    "prepare:python": "node scripts/python-environment.mjs",
    "build": "npm run build:web && npm run build:tui",
    "build:web": "npm --workspace @datagallery/web run build",
    "build:tui": "npm --workspace @datagallery/tui run build",
    "package:agentkit": "node scripts/package-agentkit.mjs",
    "start:api": "node scripts/start.mjs --api",
    "start:web": "node scripts/start.mjs --web",
    "start": "node scripts/start.mjs",
    "test:deploy": "node --test ui/shared/logging.test.mjs scripts/deploy/*.test.mjs scripts/python-environment.test.mjs scripts/makefile.test.mjs scripts/stack-runtime-config.test.mjs scripts/password-only-cutover.test.mjs",
    "smoke:native-deploy": "node scripts/deploy/smoke-native-deploy.mjs",
    "smoke:agentkit-package": "node scripts/smoke-agentkit-package.mjs",
    "test:web": "npm --workspace @datagallery/web run test",
    "test:tui": "npm --workspace @datagallery/tui run test",
    "test:product": "uv run --no-project --no-sync python scripts/run_product_tests.py",
    "start:tui": "node -- ui/tui/dist/index.js",
    "docs:dev": "python -m mkdocs serve -a 127.0.0.1:8000",
    "docs:build": "python -m mkdocs build --strict",
    "smoke:docs": "node scripts/smoke-doc-links.mjs",
    "test:yaml": "node --test ui/shared/config-yaml.test.mjs scripts/server-listen.test.mjs",
    "test:shared": "node --test ui/shared/*.test.mjs"
  },
  "overrides": {
    "@ag-ui/client": "^0.0.57",
    "@ag-ui/core": "^0.0.57"
  },
  "dependencies": {
    "yaml": "^2.9.1"
  }
}
