# Server-side model, loaded by `npm run start`. The Web UI cannot change the model.
# Values here override the DataAgent Home `.env` (~/.dataagent/.env).
LLM_MODEL=qwen-plus
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_API_KEY=

# Custom model gateway: replace LLM_BASE_URL above with your chosen endpoint.
# Installation mirror settings must be exported in the deployment shell before ./deploy.sh;
# see docs/zh/guides/mirror-deployment.md (or docs/en/guides/mirror-deployment.md).
