# 源码部署时复制为仓库根目录 .env，供 npm run start 和 deploy.sh 读取。
# 标有「export」的配置请在对应启动终端导出，尤其是独立安装的 Server 或 TUI。

# 必填｜使用默认模型模板发起对话时填写。仅启动服务可留空。
LLM_MODEL=
LLM_BASE_URL=
LLM_API_KEY=

# 选填｜Server 与源码启动器
# DATAAGENT_HOME=/absolute/path/to/home         # 独立运行时 export；默认 ~/.dataagent
# UV_PROJECT_ENVIRONMENT=/absolute/path/to/venv # 仅源码启动；使用已准备的自定义环境
# DATAAGENT_A2A_AUTH_TOKEN=                     # 启用 A2A Bearer 认证时填写
# DATAAGENT_HISTORY_SQL_CORPUS=/absolute/path/to/history-sql # 独立运行时 export
# DATAAGENT_OTLP_TRACES_ENDPOINT=https://collector.example/v1/traces # 独立运行时 export
# DATAAGENT_OTLP_HEADERS=                       # 独立运行时 export；逗号分隔的 key=value

# 选填｜TUI；直接启动客户端时从该终端 export
# NO_COLOR=1                            # 非空值关闭颜色。默认按终端能力显示颜色
# DATAAGENT_TUI_INCREMENTAL_RENDERING=0 # 改用整帧重绘。默认开启增量绘制
# DATAAGENT_TUI_OPTIMIZE_ERASE_LINES=1   # 开启多行擦除优化。默认关闭，开启后窗口顶部可能留下残影
# DATAAGENT_TUI_WHEEL_LINES_PER_TICK=3   # 每次滚轮事件滚动的行数。默认 3，接受正整数

# 使用自定义配置或插件时，按对应 YAML 中的 $env{NAME} 引用补充变量。
