# DataAgent 环境变量配置模板，请复制此文件为 .env 并设置实际值。
# 约定：.env 仅放密钥/环境相关值；YAML 仅放 Agent 行为定义。
# YAML 中使用 $env{VAR_NAME} 显式引用环境变量。

# ===== LLM 平台配置 =====
# YAML 中 MODEL.*.provider 字段作为平台名，自动查找 {PROVIDER}_BASE_URL 和 {PROVIDER}_API_KEY。
# 例如：provider: "deepseek" -> DEEPSEEK_BASE_URL + DEEPSEEK_API_KEY

# 日志配置
# DATAAGENT_LOG_PATH：节点本地日志目录（默认 ${DATAAGENT_HOME}/logs）；活动文件为 main.<pid>.log
# DATAAGENT_LOG_ROTATION：单文件大小上限（Loguru 格式，默认 100 MB）
# DATAAGENT_LOG_RETENTION_COUNT：整个日志目录保留的历史文件数（默认 20，不含存活 PID 活动文件）
# 多 worker 清理锁为 Linux fcntl.flock（.retention.lock）；目录按节点本地语义，非 NFS 多主机共享
DATAAGENT_LOG_LEVEL="INFO"
# DATAAGENT_LOG_PATH=""
# DATAAGENT_LOG_ROTATION="100 MB"
# DATAAGENT_LOG_RETENTION_COUNT="20"

# DeepSeek
DEEPSEEK_BASE_URL="https://api.deepseek.com"
DEEPSEEK_API_KEY=""

BAILIAN_BASE_URL="https://dashscope.aliyuncs.com/compatible-mode/v1"
BAILIAN_API_KEY=""

OPENAI_BASE_URL="https://api.openai.com/v1"
OPENAI_API_KEY=""

ANTHROPIC_BASE_URL="https://api.anthropic.com"
ANTHROPIC_API_KEY=""

# ===== Embedding 服务（可选，Memory / 向量相关能力需要时配置）=====
EMBEDDING_BASE_URL=""
EMBEDDING_API_KEY=""

# ===== 数据源 / NL2SQL =====
DATASOURCE_DATABASE_ADDRESS="mysql+pymysql://root:password@localhost:3306"

# ===== Semantic Service（可选）=====
# 本地开发示例场景：financial、bio_research、manufacturing
SCENE="financial"
ONTOLOGY_URL="http://localhost:8000"

# ===== 部署分区（可选）=====
DEPLOY_ZONE="internal" # 区分内部和外部环境
