# Licensed under the Apache License, Version 2.0
# Environment configuration for the DataOps AdHoc SQL Validator MCP Server.
#
# Copy this file to .env in the same directory as dataops_mcp_server.py
# and fill in your values.
#
# ===== DataOps OpenAPI connection =====
# Base URL of the DataOps OpenAPI endpoint (no /v3 suffix)
DATAOPS_BASE_URL=https://dataops.yourcompany.com/openapi

# ===== HMAC-SHA256 Authentication =====
# App ID assigned by DataOps OpenAPI
DATAOPS_APPID=your-appid-here
# Secret key for HMAC-SHA256 signature
DATAOPS_SECRET_KEY=your-secret-key-here
# Service instance ID (sub-domain ID)
DATAOPS_SERVICE_INSTANCE_ID=your-instance-id-here

# ===== Query engine =====
# "hive" (default) or "clickhouse"
DATAOPS_SOURCE_TYPE=hive
# HIVE cluster name (used when SOURCE_TYPE=hive)
DATAOPS_HIVE_RESOURCE_NAME=hive_cluster_a
# ClickHouse connection ID (used when SOURCE_TYPE=clickhouse)
DATAOPS_CLICKHOUSE_RESOURCE_NAME=
# Hive/ClickHouse database name
DATAOPS_DATABASE_NAME=default
# Execution user
DATAOPS_EXEC_USER=alice
# Query engine for ClickHouse: Spark, Clickhouse, Spark_Sync, Auto_Select (default)
DATAOPS_ENGINE=

# ===== MCP server binding =====
DATAOPS_MCP_HOST=0.0.0.0
DATAOPS_MCP_PORT=8767

# ===== HTTP client =====
# Per-request timeout in seconds (default: 30)
DATAOPS_REQUEST_TIMEOUT_SEC=30
