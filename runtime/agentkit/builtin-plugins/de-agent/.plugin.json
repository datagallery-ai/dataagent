{
  "schema_version": 2,
  "id": "de-agent",
  "requires": [
    "nl2sql"
  ],
  "config": "config.json",
  "system_prompt": "prompts/agent.md",
  "skills": [
    "skills"
  ],
  "subagents": [
    "subagents/metadata-recall.json"
  ],
  "tools": {
    "get_table_schema": {
      "entrypoint": "tools/metadata.py:get_table_schema",
      "scope": "subagents"
    },
    "get_join_relations": {
      "entrypoint": "tools/metadata.py:get_join_relations",
      "scope": "subagents"
    },
    "search_udf_function_by_name_keyword": {
      "entrypoint": "tools/metadata.py:search_udf_function_by_name_keyword",
      "scope": "subagents"
    },
    "search_udf_function_by_dsl": {
      "entrypoint": "tools/metadata.py:search_udf_function_by_dsl",
      "scope": "subagents"
    },
    "validate_table_name": {
      "entrypoint": "tools/metadata.py:validate_table_name"
    },
    "check_table_existence": {
      "entrypoint": "tools/metadata.py:check_table_existence"
    },
    "query_sql_process": {
      "entrypoint": "tools/metadata.py:query_sql_process"
    },
    "validate_deliverables": {
      "entrypoint": "tools/deliverables.py:validate_deliverables"
    },
    "validate_word_roots": {
      "entrypoint": "tools/word_roots.py:validate_word_roots"
    },
    "read_ir": {
      "entrypoint": "tools/ir.py:read_ir"
    }
  },
  "hooks": {
    "after_tool": [
      {
        "entrypoint": "hooks/word_roots.py:check_word_roots",
        "matcher": "write_file"
      },
      {
        "entrypoint": "hooks/word_roots.py:check_word_roots",
        "matcher": "edit_file"
      },
      {
        "entrypoint": "hooks/files.py:check_ddl",
        "matcher": "write_file"
      },
      {
        "entrypoint": "hooks/files.py:check_ddl",
        "matcher": "edit_file"
      },
      {
        "entrypoint": "hooks/files.py:check_insert_syntax",
        "matcher": "write_file"
      },
      {
        "entrypoint": "hooks/files.py:check_insert_syntax",
        "matcher": "edit_file"
      },
      {
        "entrypoint": "hooks/ir.py:update_ir",
        "matcher": "write_todos"
      }
    ],
    "before_tool": [
      {
        "entrypoint": "hooks/metadata.py:prepare_recall",
        "matcher": "task"
      },
      {
        "entrypoint": "hooks/files.py:guard_insert",
        "matcher": "write_file"
      },
      {
        "entrypoint": "hooks/ir.py:ensure_ir_ready",
        "matcher": "task"
      },
      {
        "entrypoint": "hooks/ir.py:ensure_ir_ready",
        "matcher": "validate_deliverables"
      }
    ]
  }
}
