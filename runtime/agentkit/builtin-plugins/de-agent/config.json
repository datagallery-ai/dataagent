{
  "plugins": {
    "config": {
      "de-agent": {
        "allowed_databases": [],
        "quality_gate": true,
        "quality_gate_include_suggestions": false,
        "model": "primary",
        "word_roots": {
          "english_name_column": "词根英文名",
          "chinese_name_column": "词根中文名",
          "description_column": "描述",
          "type_column": "词根类型",
          "regex_column": "特殊词根规则",
          "special_type_value": "特殊词根",
          "llm_model": "primary"
        },
        "data_task_ir": {
          "enabled": false,
          "model": "primary",
          "refresh_policy": "eager",
          "max_concurrency": 8,
          "completion_batch_size": 1,
          "completion_policy": "always",
          "concise_rationale": false,
          "compact_json": false,
          "field_order": "template",
          "semantic_field_reuse": false
        }
      },
      "nl2sql": {
        "model": "primary",
        "database": {
          "dialect": "hive"
        },
        "nodes": [
          "perceptor",
          "generator",
          "validator",
          "reflector"
        ],
        "generator": {
          "strategies": [
            "prompt"
          ]
        },
        "validator": {
          "read_only": false,
          "db_explain": false,
          "sql_security_enabled": false
        },
        "hooks": {
          "before_run": [
            {
              "entrypoint": "hooks/nl2sql.py:prepare_input"
            }
          ],
          "after_run": [
            {
              "entrypoint": "hooks/nl2sql.py:finish_output"
            }
          ]
        }
      }
    }
  }
}
