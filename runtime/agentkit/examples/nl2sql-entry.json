{
  "schema_version": 3,
  "dataagent": {
    "model": {
      "default": "primary"
    },
    "limits": {
      "timeout_seconds": 180
    },
    "entry": "nl2sql"
  },
  "models": {
    "primary": {
      "provider": "openai",
      "name": "$env{LLM_MODEL}",
      "base_url": "$env{LLM_BASE_URL}",
      "api_key": "$env{LLM_API_KEY}"
    }
  },
  "plugins": {
    "enabled": [
      "nl2sql"
    ],
    "config": {
      "nl2sql": {
        "model": "primary",
        "model_call_budget": 64,
        "database": {
          "db_id": "mydb",
          "dialect": "sqlite",
          "engine": "sqlite",
          "path": "$env{NL2SQL_DATABASE_PATH}"
        }
      }
    }
  },
  "semantic": {
    "base_url": "$env{SEMANTIC_BASE_URL}"
  }
}
