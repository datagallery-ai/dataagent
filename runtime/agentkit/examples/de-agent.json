{
  "models": {
    "primary": {
      "name": "deepseek-chat",
      "base_url": "$env{DEEPSEEK_BASE_URL}",
      "api_key": "$env{DEEPSEEK_API_KEY}"
    }
  },
  "semantic": {
    "base_url": "$env{SEMANTIC_BASE_URL}"
  },
  "plugins": {
    "enabled": [
      "de-agent"
    ],
    "config": {
      "de-agent": {
        "word_roots": {
          "csv_path": "$env{WORD_ROOT_CSV_PATH}"
        }
      }
    }
  }
}
