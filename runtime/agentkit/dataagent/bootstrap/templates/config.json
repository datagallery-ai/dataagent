{
  "schema_version": 3,
  "dataagent": {
    "model": {
      "default": "primary"
    },
    "limits": {
      "timeout_seconds": 180,
      "model_calls_per_agent": 128,
      "tool_calls_per_agent": 128
    },
    "hooks": {
      "before_agent": [],
      "after_agent": [],
      "before_model": [],
      "after_model": [],
      "before_tool": [],
      "after_tool": []
    }
  },
  "models": {
    "primary": {
      "provider": "openai",
      "name": "$env{LLM_MODEL}",
      "base_url": "$env{LLM_BASE_URL}",
      "api_key": "$env{LLM_API_KEY}",
      "max_retries": 2
    }
  },
  "plugins": {
    "enabled": [],
    "paths": []
  },
  "server": {
    "host": "127.0.0.1",
    "port": 8790
  }
}
